-
         const auto& colorConfig = TSA::Coordinate::AxisColorConfig::instance();
-
-        m_workPlaneAxisXShape = new AIS_Shape(BRepBuilderAPI_MakeEdge(orig, pX).Edge());
-        m_workPlaneAxisXShape->SetColor(colorConfig.workPlaneAxisXColor());
