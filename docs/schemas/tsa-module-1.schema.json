{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsaraloha.org/schemas/tsa-module-1.schema.json",
  "title": "Manifeste de module Tsaraloha (module.json, tsa-module/1)",
  "description": "Contrat d'intégration d'un module TSA / TSALab (docs/SDK.md). La validation de l'application (ModuleManifest::fromJson) contrôle en plus la présence des fichiers et le confinement des chemins.",
  "type": "object",
  "required": ["schema", "id", "name", "version", "hosts"],
  "properties": {
    "schema": { "const": "tsa-module/1" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9_-]+)+$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "$ref": "#/$defs/version" },
    "description": { "type": "string" },
    "publisher": { "type": "string" },
    "license": { "type": "string" },
    "hosts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["application", "min"],
        "properties": {
          "application": { "enum": ["TSA", "TSALab"] },
          "min": { "$ref": "#/$defs/version" },
          "max": { "$ref": "#/$defs/version" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id"],
        "properties": { "id": { "type": "string" }, "min": { "$ref": "#/$defs/version" }, "optional": { "type": "boolean" } }
      }
    },
    "capabilities": { "type": "array", "items": { "enum": ["plugin", "process", "templates"] }, "uniqueItems": true },
    "dataTypes": { "type": "array", "items": { "type": "string" } },
    "entryPoints": {
      "type": "object",
      "properties": {
        "plugin": { "$ref": "#/$defs/relativePath" },
        "importers": { "type": "array", "items": { "$ref": "#/$defs/converter" } },
        "exporters": { "type": "array", "items": { "$ref": "#/$defs/converter" } }
      }
    },
    "templates": { "type": "array", "items": { "$ref": "#/$defs/relativePath" } },
    "resources": { "type": "array", "items": { "$ref": "#/$defs/relativePath" } }
  },
  "$defs": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+(\\.\\d+)?$" },
    "relativePath": { "type": "string", "minLength": 1, "not": { "pattern": "(\\.\\.|:|^/|^\\\\)" } },
    "converter": {
      "type": "object", "required": ["id", "extensions", "command"],
      "properties": {
        "id": { "type": "string", "description": "préfixé par l'identifiant du module" },
        "title": { "type": "string" },
        "extensions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "command": { "$ref": "#/$defs/relativePath" },
        "arguments": { "type": "array", "items": { "type": "string" }, "description": "{input} et {output} obligatoires ; défaut [\"{input}\", \"{output}\"]" }
      }
    }
  }
}
