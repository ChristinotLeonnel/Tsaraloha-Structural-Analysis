{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 Release",
      "description": "Build with MSVC x64 in Release mode",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "OpenCASCADE_DIR": "${sourceDir}/opencascade-8.0.1-vc14-64/cmake"
      }
    },
    {
      "name": "windows-x64-debug",
      "displayName": "Windows x64 Debug",
      "description": "Build with MSVC x64 in Debug mode",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "OpenCASCADE_DIR": "${sourceDir}/opencascade-8.0.1-vc14-64/cmake"
      }
    },
    {
      "name": "ninja-base",
      "hidden": true,
      "generator": "Ninja",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "environment": {
        "VSLANG": "1033"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "OpenCASCADE_DIR": "${sourceDir}/opencascade-8.0.1-vc14-64/cmake"
      }
    },
    {
      "name": "ninja-debug",
      "displayName": "Windows x64 Debug (Ninja, rapide)",
      "description": "Ninja + MSVC. À lancer depuis 'x64 Native Tools Command Prompt for VS' (ou depuis Visual Studio).",
      "inherits": "ninja-base",
      "binaryDir": "${sourceDir}/build-ninja-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ninja-release",
      "displayName": "Windows x64 Release (Ninja, rapide)",
      "description": "Ninja + MSVC. À lancer depuis 'x64 Native Tools Command Prompt for VS' (ou depuis Visual Studio).",
      "inherits": "ninja-base",
      "binaryDir": "${sourceDir}/build-ninja-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "description": "Ninja + GCC/Clang. Qt 6 et OCCT 8 trouvés par CMAKE_PREFIX_PATH (scripts/linux/configure.sh, docs/LINUX_BUILD.md).",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux x64 Debug (Ninja)",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/build-linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux x64 Release (Ninja)",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/build-linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release",
      "configuration": "Release"
    },
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64-debug",
      "configuration": "Debug"
    },
    {
      "name": "ninja-debug",
      "configurePreset": "ninja-debug"
    },
    {
      "name": "ninja-release",
      "configurePreset": "ninja-release"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    }
  ]
}
