{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-only",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 Release",
      "description": "Build with MSVC x64 in Release mode",
      "inherits": "windows-only",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "Qt6_DIR": "C:/Qt/6.11.2/msvc2022_64/lib/cmake/Qt6",
        "OpenCASCADE_DIR": "${sourceDir}/opencascade-8.0.1-vc14-64/cmake"
      }
    },
    {
      "name": "windows-x64-debug",
      "displayName": "Windows x64 Debug",
      "description": "Build with MSVC x64 in Debug mode",
      "inherits": "windows-only",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "Qt6_DIR": "C:/Qt/6.11.2/msvc2022_64/lib/cmake/Qt6",
        "OpenCASCADE_DIR": "${sourceDir}/opencascade-8.0.1-vc14-64/cmake"
      }
    },
    {
      "name": "ninja-base",
      "hidden": true,
      "inherits": "windows-only",
      "generator": "Ninja",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "environment": {
        "VSLANG": "1033"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "Qt6_DIR": "C:/Qt/6.11.2/msvc2022_64/lib/cmake/Qt6",
        "OpenCASCADE_DIR": "${sourceDir}/opencascade-8.0.1-vc14-64/cmake"
      }
    },
    {
      "name": "ninja-debug",
      "displayName": "Windows x64 Debug (Ninja, rapide)",
      "description": "Ninja + MSVC. À lancer depuis 'x64 Native Tools Command Prompt for VS' (ou depuis Visual Studio).",
      "inherits": "ninja-base",
      "binaryDir": "${sourceDir}/build-ninja-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ninja-release",
      "displayName": "Windows x64 Release (Ninja, rapide)",
      "description": "Ninja + MSVC. À lancer depuis 'x64 Native Tools Command Prompt for VS' (ou depuis Visual Studio).",
      "inherits": "ninja-base",
      "binaryDir": "${sourceDir}/build-ninja-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "description": "Ninja + GCC ou Clang. Qt de l'installateur officiel (~/Qt/6.11.2/gcc_64) ; OCCT installé sur le système (/usr/local ou paquets). Dossiers build-linux-* distincts des dossiers Windows (disque partagé).",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{HOME}/Qt/6.11.2/gcc_64"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux x64 Debug (Ninja)",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/build-linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux x64 Release (Ninja)",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/build-linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-build",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-build",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "windows-x64-release",
      "inherits": "windows-build",
      "configurePreset": "windows-x64-release",
      "configuration": "Release"
    },
    {
      "name": "windows-x64-debug",
      "inherits": "windows-build",
      "configurePreset": "windows-x64-debug",
      "configuration": "Debug"
    },
    {
      "name": "ninja-debug",
      "inherits": "windows-build",
      "configurePreset": "ninja-debug"
    },
    {
      "name": "ninja-release",
      "inherits": "windows-build",
      "configurePreset": "ninja-release"
    },
    {
      "name": "linux-debug",
      "inherits": "linux-build",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "inherits": "linux-build",
      "configurePreset": "linux-release"
    }
  ]
}
